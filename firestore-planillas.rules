// ===== Planillas (repo luchorcompartidos/planillas) — bloque de reglas de Firestore (v0.0.10; compartir desde la v0.0.11) =====
//
// Planillas usa el mismo proyecto de Firebase que ANote... (notas-pro-2026), así que las reglas son UN SOLO archivo
// en la consola. Este bloque se AGREGA a las reglas de ANote..., sin tocar nada de lo de ANote...:
//
//   1. Firebase → Firestore Database → Reglas.
//   2. Ir al final y buscar el bloque de ANote... que empieza con  match /users/{uid}/{document=**} {
//      Después de su  }  quedan dos  }  más (los de "match /databases/..." y "service cloud.firestore").
//   3. Pegar todo lo que está entre las dos líneas "PEGAR DESDE ACÁ" / "HASTA ACÁ" justo ANTES de esos dos  }  finales.
//      SI YA ESTÁ el bloque de la v0.0.10 (empieza con  // Planillas (v0.0.10)  o con  function sheetPath ),
//      REEMPLAZARLO entero por este: borrar desde  function sheetPath  hasta el  }  que cierra  match /sheets/{sheetId}
//      y pegar este en su lugar (no tiene que quedar dos veces  function sheetPath : Firebase no deja publicar).
//   4. Publicar.
//
// Usa las funciones signedIn(), emailOk(), myEmail() y changed() de las reglas de ANote... (por eso va adentro del
// mismo "match /databases/..."). No define funciones con esos nombres (Firebase no deja repetirlos).
// OJO: si alguna vez se pegan de nuevo las reglas completas de ANote... (firestore.rules del repo notas), este bloque
// se pierde y hay que volver a agregarlo (o sumarlo también al firestore.rules de ANote...).

    // ----- PEGAR DESDE ACÁ -----
    // Planillas (v0.0.11): planillas guardadas en la nube y compartidas. Cada una tiene su dueño (owner), sus
    // miembros (memberIds), el permiso de cada uno (roles: 'edit' o 'view') y nombre/correo (members).
    // El contenido va en partes: sheets/{id}/parts/{n}. Invitaciones: sheetInvites/{idDeLaPlanilla}_{correo}.
    function sheetPath(sheetId) {
      return /databases/$(database)/documents/sheets/$(sheetId);
    }
    // Dueño, o miembro con «Puede editar»
    function sheetCanEdit(data) {
      return signedIn() && (data.owner == request.auth.uid
        || (request.auth.uid in data.memberIds && data.get('roles', {}).get(request.auth.uid, 'view') == 'edit'));
    }
    // Para las partes: puede editar antes del cambio, o es el dueño después (al crearla, en la misma transacción)
    function sheetEditableNow(sheetId) {
      return (exists(sheetPath(sheetId)) && sheetCanEdit(get(sheetPath(sheetId)).data))
        || (existsAfter(sheetPath(sheetId)) && getAfter(sheetPath(sheetId)).data.owner == request.auth.uid);
    }
    function sheetInviteFor(sheetId) {
      return /databases/$(database)/documents/sheetInvites/$(sheetId + '_' + myEmail());
    }
    match /sheets/{sheetId} {
      // resource == null: la planilla todavía no existe (al subirla por primera vez, la transacción la lee antes;
      // sin esto Firebase rechaza esa lectura y no se puede crear)
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.memberIds);
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.ver is int;
      allow update: if signedIn() && request.resource.data.ver is int && (
        // El dueño: todo menos cambiar de dueño o sacarse a sí mismo
        (resource.data.owner == request.auth.uid
          && request.resource.data.owner == resource.data.owner
          && request.auth.uid in request.resource.data.memberIds)
        // Quien puede editar: el contenido, no los miembros ni los permisos
        || (sheetCanEdit(resource.data) && !changed().hasAny(['owner', 'memberIds', 'roles', 'members']))
        // Un miembro (no el dueño) que sale de la planilla
        || (request.auth.uid in resource.data.memberIds
          && resource.data.owner != request.auth.uid
          && changed().hasOnly(['memberIds', 'roles', 'members'])
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid]))
        // Quien acepta una invitación (con el correo verificado): se agrega a sí mismo, con el permiso de la invitación
        || (emailOk()
          && !(request.auth.uid in resource.data.memberIds)
          && exists(sheetInviteFor(sheetId))
          && changed().hasOnly(['memberIds', 'roles', 'members'])
          && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
          && request.resource.data.roles.diff(resource.data.get('roles', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.roles[request.auth.uid] == get(sheetInviteFor(sheetId)).data.role
          && request.resource.data.get('members', {}).diff(resource.data.get('members', {})).affectedKeys().hasOnly([request.auth.uid]))
      );
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /parts/{partId} {
        allow read: if signedIn() && request.auth.uid in get(sheetPath(sheetId)).data.memberIds;
        allow write: if sheetEditableNow(sheetId);
      }
    }
    // Invitaciones de Planillas: las crea el dueño; las ve y las borra quien invitó o la persona invitada (con el
    // correo verificado: sin eso, alguien podría registrarse con un correo ajeno y ver lo que le compartieron a otro).
    match /sheetInvites/{inviteId} {
      allow read: if signedIn() && ((emailOk() && resource.data.email == myEmail()) || resource.data.from == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.from == request.auth.uid
        && get(sheetPath(request.resource.data.sheetId)).data.owner == request.auth.uid
        && inviteId == request.resource.data.sheetId + '_' + request.resource.data.email
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.role in ['edit', 'view'];
      allow delete: if signedIn() && ((emailOk() && resource.data.email == myEmail()) || resource.data.from == request.auth.uid);
    }
    // ----- HASTA ACÁ -----
